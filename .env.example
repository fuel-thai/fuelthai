# ─── Build-time (Vite) ─────────────────────────────────────────
# Cloudflare Web Analytics beacon token (optional)
VITE_CF_BEACON=your-cf-beacon-token

# Google Analytics measurement ID (optional)
VITE_GA_ID=G-XXXXXXXXXX

# ─── Ingest script (tools/ingest.ts) ──────────────────────────
# Auth key for /api/ingest endpoint (same as CRON_SECRET)
FUELTHAI_KEY=your-cron-secret

# Target API URL (default: https://www.fuelthai.com)
# FUELTHAI_URL=https://www.fuelthai.com

# FRED API key (free: https://fredaccount.stlouisfed.org/login/create/)
FRED_API_KEY=your-fred-api-key
